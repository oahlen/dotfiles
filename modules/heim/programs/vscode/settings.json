{
  "editor.cursorSurroundingLines": 10,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.lineNumbers": "relative",
  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        {
          "scope": "comment",
          "settings": {
            "fontStyle": "italic",
            "foreground": "#7e86a0"
          }
        },
        {
          "scope": "string",
          "settings": {
            "foreground": "#a6d279"
          }
        },
        {
          "scope": [
            "keyword",
            "keyword.control",
            "storage"
          ],
          "settings": {
            "foreground": "#d2a6f2"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function"
          ],
          "settings": {
            "foreground": "#89b6f5"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language"
          ],
          "settings": {
            "foreground": "#ffac70"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "entity.name.class"
          ],
          "settings": {
            "foreground": "#89d7e6"
          }
        },
        {
          "scope": [
            "variable.other.property",
            "variable.other.object.property",
            "support.type.property-name",
            "meta.object-literal.key"
          ],
          "settings": {
            "foreground": "#c6cbdd"
          }
        },
        {
          "scope": "support.type.property-name.json",
          "settings": {
            "foreground": "#89b6f5"
          }
        },
        {
          "scope": "variable",
          "settings": {
            "foreground": "#c6cbdd"
          }
        }
      ]
    },
    "[Light Modern]": {
      "textMateRules": [
        {
          "scope": "comment",
          "settings": {
            "fontStyle": "italic",
            "foreground": "#68718d"
          }
        },
        {
          "scope": "string",
          "settings": {
            "foreground": "#407010"
          }
        },
        {
          "scope": [
            "keyword",
            "keyword.control",
            "storage"
          ],
          "settings": {
            "foreground": "#884fb0"
          }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function"
          ],
          "settings": {
            "foreground": "#376fbe"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language"
          ],
          "settings": {
            "foreground": "#a34400"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "entity.name.class"
          ],
          "settings": {
            "foreground": "#137386"
          }
        },
        {
          "scope": [
            "variable.other.property",
            "variable.other.object.property",
            "support.type.property-name",
            "meta.object-literal.key"
          ],
          "settings": {
            "foreground": "#394056"
          }
        },
        {
          "scope": "support.type.property-name.json",
          "settings": {
            "foreground": "#376fbe"
          }
        },
        {
          "scope": "variable",
          "settings": {
            "foreground": "#394056"
          }
        }
      ]
    }
  },
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "vim.hlsearch": true,
  "vim.ignorecase": true,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "after": [
        "y",
        "$"
      ],
      "before": [
        "Y"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        "workbench.action.navigateLeft"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "commands": [
        "workbench.action.navigateDown"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "commands": [
        "workbench.action.navigateUp"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        "workbench.action.navigateRight"
      ]
    },
    {
      "after": [
        "<C-d>",
        "z",
        "z"
      ],
      "before": [
        "<C-d>"
      ]
    },
    {
      "after": [
        "<C-u>",
        "z",
        "z"
      ],
      "before": [
        "<C-u>"
      ]
    },
    {
      "after": [
        "n",
        "z",
        "z",
        "z",
        "v"
      ],
      "before": [
        "n"
      ]
    },
    {
      "after": [
        "N",
        "z",
        "z",
        "z",
        "v"
      ],
      "before": [
        "N"
      ]
    },
    {
      "before": [
        "<Esc>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "H"
      ],
      "commands": [
        "workbench.action.previousEditor"
      ]
    },
    {
      "before": [
        "L"
      ],
      "commands": [
        "workbench.action.nextEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "q"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "g"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "b"
      ],
      "commands": [
        "workbench.action.openRecent"
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.files.action.focusFilesExplorer"
      ]
    },
    {
      "before": [
        "<leader>",
        "E"
      ],
      "commands": [
        "workbench.files.action.showActiveFileInExplorer"
      ]
    },
    {
      "before": [
        "gd"
      ],
      "commands": [
        "editor.action.revealDefinition"
      ]
    },
    {
      "before": [
        "gri"
      ],
      "commands": [
        "editor.action.goToImplementation"
      ]
    },
    {
      "before": [
        "grr"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    {
      "before": [
        "grn"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    {
      "before": [
        "gn"
      ],
      "commands": [
        "editor.action.marker.next"
      ]
    },
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ]
    },
    {
      "before": [
        "=",
        "="
      ],
      "commands": [
        "editor.action.formatSelection"
      ]
    },
    {
      "before": [
        "gj"
      ],
      "commands": [
        "editor.action.dirtydiff.next"
      ]
    },
    {
      "before": [
        "gk"
      ],
      "commands": [
        "editor.action.dirtydiff.previous"
      ]
    }
  ],
  "vim.smartcase": true,
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "after": [
        "<",
        "g",
        "v"
      ],
      "before": [
        "<"
      ]
    },
    {
      "after": [
        ">",
        "g",
        "v"
      ],
      "before": [
        ">"
      ]
    },
    {
      "before": [
        "gc"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    {
      "before": [
        "gb"
      ],
      "commands": [
        "editor.action.blockComment"
      ]
    }
  ],
  "window.autoDetectColorScheme": true,
