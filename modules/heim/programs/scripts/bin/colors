#!/usr/bin/env bash

set -euo pipefail

T="gYw"

echo ""
printf "       │  def     40m     41m     42m     43m     44m     45m     46m     47m  \n"
printf " ──────┼───────────────────────────────────────────────────────────────────────\n"

FG_LIST=(
    "    m" "   1m" "  30m" "1;30m" "  31m" "1;31m" "  32m"
    "1;32m" "  33m" "1;33m" "  34m" "1;34m" "  35m" "1;35m"
    "  36m" "1;36m" "  37m" "1;37m"
)

for FGs in "${FG_LIST[@]}"; do
    FG=$(echo -n "$FGs" | tr -d '[:space:]')
    printf " %s │\033[%s  %s  " "$FGs" "$FG" "$T"

    for BG in 40m 41m 42m 43m 44m 45m 46m 47m; do
        printf "\033[%s\033[%s  %s  \033[0m" "$FG" "$BG" "$T"
    done
    echo
done
echo
